"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    var borderWidth = wall.clientLeft;
    var rect = wall.getBoundingClientRect();
    var spider = document.querySelector(".spider");
    var spiderHalfWidth = spider.clientWidth / 2;
    var spiderHalfHeight = spider.clientHeight / 2;
    if (!e.target.closest(".wall")) return;
    var posX = e.clientX - rect.left - borderWidth - spiderHalfWidth;
    if (posX < 0) posX = 0;
    else if (posX + spider.clientHeight >= rect.width - borderWidth) posX = rect.width - spider.clientHeight - borderWidth * 2;
    var posY = e.clientY - rect.top - borderWidth - spiderHalfHeight;
    if (posY < 0) posY = 0;
    else if (posY + spider.clientHeight >= rect.height - borderWidth) posY = rect.height - spider.clientHeight - borderWidth * 2;
    spider.style.left = "".concat(posX, "px");
    spider.style.top = "".concat(posY, "px");
});

